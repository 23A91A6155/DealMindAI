# ==========================================
# DealMind AI - Environment Configuration
# ==========================================

# Hindsight Configuration
# Default Hindsight API URL: https://api.hindsight.vectorize.io or http://localhost:8888 for local instance
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=dealmind-demo

# AI Model Configuration (Groq API or LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_PATH=backend/dealmind.db
